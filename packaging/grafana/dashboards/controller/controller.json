    {
      "type": "timeseries",
      "title": "Unhealthy Agents by Instance",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "(sum by(instance_uuid)(controller_proxmetrics_agents_total{instance_uuid!=\"\"}) - sum by(instance_uuid)(controller_proxmetrics_agents_healthy{instance_uuid!=\"\"})) * on(instance_uuid) group_left(name) label_replace(max by(uuid, name)(flock_controller_store_info{type_url=\"type.googleapis.com/flock.api.config.instance.v1.Instance\"}), \"instance_uuid\", \"$1\", \"uuid\", \"(.*)\")",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
