    },
    {
      "type": "table",
      "title": "Locked Out Users",
      "description": "Users locked out after too many failed logins",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "max by(username)(login_locked_out{instance=~\"$controller\",instance_uuid=\"\"}) == 1",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "exported_instance": true,
              "agent_uuid": true,
              "agent_type": true,
              "agent_host": true,
              "target": true,
              "instance_uuid": true,
              "instance_name": true
            },
            "renameByName": {
              "username": "User",
              "Value": "Locked"
            }
          }
        }
      ],
      "id": 15
    },
    {
      "type": "row",
