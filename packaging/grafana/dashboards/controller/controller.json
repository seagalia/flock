            "stacking": {
              "group": "A",
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 17
    },
    {
      "type": "table",
      "title": "Agents the Controller Can't Scrape",
      "description": "Agents whose metrics the controller failed to fetch on the last scrape",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "expr": "(max by(instance_uuid, agent_name, error)(controller_proxmetrics_scrape_error{instance_uuid!=\"\"})) * on(instance_uuid) group_left(name) label_replace(max by(uuid, name)(flock_controller_store_info{type_url=\"type.googleapis.com/flock.api.config.instance.v1.Instance\"}), \"instance_uuid\", \"$1\", \"uuid\", \"(.*)\")",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "exported_instance": true,
              "agent_uuid": true,
              "agent_type": true,
              "agent_host": true,
              "target": true,
              "instance_uuid": true,
              "instance_name": true
            },
            "renameByName": {
              "name": "Instance",
              "agent_name": "Agent",
              "error": "Error"
            }
          }
        }
      ],
      "id": 18
    },
    {
      "type": "row",
      "title": "Database",
      "collapsed": false,
      "id": 19,
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
