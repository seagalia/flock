        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Authorization Failures by User",
      "description": "Calls refused because the user has no permission on the resource",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by(username, resource_type)(rate(authorization_failure{instance=~\"$controller\",instance_uuid=\"\"}[$__rate_interval])) > 0",
          "legendFormat": "{{username}} on {{resource_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
